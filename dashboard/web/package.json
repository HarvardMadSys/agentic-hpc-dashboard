{
  "name": "rc-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Live HPC agent-behaviour dashboard frontend (rc_measurement)",
  "scripts": {
    "dev": "vite",
    "dev:real": "vite --mode real",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "fixture": "node mock/gen_fixture.mjs",
    "check": "npm run -s check:no-random && node --test mock/check_*.mjs",
    "check:no-random": "! grep -rn 'Math\\.random' src/ || (echo 'FAIL: Math.random() in src/' && exit 1)",
    "check:phases": "node --test mock/check_phases.mjs",
    "check:charts": "node --test mock/check_charts.mjs",
    "check:figures": "node --test mock/check_figures.mjs",
    "check:css": "node --test mock/check_css.mjs",
    "check:shares": "node --test mock/check_shares.mjs",
    "check:panels": "node --test mock/check_panels.mjs",
    "check:live": "node --test mock/check_live.mjs",
    "check:lookup": "node --test mock/check_lookup.mjs",
    "check:procexit": "node --test mock/check_procexit.mjs",
    "check:security": "node --test mock/check_security.mjs",
    "check:hpc": "node --test mock/check_hpc.mjs",
    "check:io": "node --test mock/check_io.mjs",
    "check:tabs": "node --test mock/check_tabs.mjs",
    "check:internal": "node --test mock/check_internal.mjs",
    "check:ux": "node --test mock/check_ux.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
