# @ETC@/dashboard.env: the dashboard's settings. rc-dashboard.service reads it as a
# systemd EnvironmentFile: KEY=VALUE, one per line, a value with spaces in double quotes.
# Any RC_DASH_* variable dashboard/README.md names works here. install-dashboard.sh writes
# this file only when there is none, so your edits stay, and sets in it the settings it is
# given (SITE_NAME, SITE_DESCRIPTION, SLURM, NODE_NOUN, ANONYMIZE: deploy/README.md,
# "Settings"); after an edit:
#   systemctl restart rc-dashboard
# Where the dashboard reads and keeps things is in paths.env beside this file, which the
# installer writes on every run, and which wins over a setting here.

# The one password readers sign in with is not here: its hash is in @ETC@/password.hash,
# which `@REPO@/deploy/common/password.sh` (or `deploy/rc-deploy password`) writes, and
# which the dashboard reads again whenever it changes. A hash put here instead, as
# RC_DASH_PASSWORD_HASH='scrypt$...' in single quotes, still works, but needs a restart to
# change. The service does not start without one, unless RC_DASH_OPEN=1 serves the page
# with no sign-in to anyone who reaches the port: then keep RC_DASH_HOST at 127.0.0.1 on a
# host no one else logs in to (dashboard/README.md, "Password").
RC_DASH_PASSWORD_HASH=

# Or the site's single sign-on (OIDC, SAML) admits readers, through a reverse proxy --
# oauth2-proxy, Apache's mod_auth_openidc, Open OnDemand -- that signs each reader in,
# names them in a header, and strips any copy of it a client sent (dashboard/README.md,
# "Single sign-on through a proxy"). The dashboard then starts with no password; one set
# above stays the way in for a request the proxy did not sign in. The header is believed
# only with the secret the proxy sends on every request in X-RC-Proxy-Secret: the
# installer makes it, /etc/rc-dashboard/proxy.secret, and names it in paths.env. And only
# from RC_DASH_PROXY_TRUSTED, an address the proxy connects from. Groups: commas or
# spaces. A proxy that passes its public name in the Host needs it in RC_DASH_ALLOWED_HOSTS.
#RC_DASH_PROXY_HEADER=X-Forwarded-User
#RC_DASH_PROXY_TRUSTED=127.0.0.1,::1
#RC_DASH_PROXY_GROUPS_HEADER=X-Forwarded-Groups
#RC_DASH_PROXY_GROUPS=dashboard-readers
#RC_DASH_PROXY_LOGOUT_URL=/oauth2/sign_out
#RC_DASH_ALLOWED_HOSTS=dash.example.org

# Where the page listens. On 127.0.0.1, reach it through a tunnel from your machine,
#   ssh -N -L 8080:127.0.0.1:8080 <this host>
# or put a reverse proxy in front of it (a proxy that rewrites the Host needs the page's
# public origin in RC_DASH_ALLOWED_ORIGINS, comma-separated).
RC_DASH_HOST=127.0.0.1
RC_DASH_PORT=8080

# What every page calls the deployment, and the hosts it watches ("Servers right now").
RC_DASH_SITE_NAME="servers · live"
RC_DASH_NODE_NOUN=servers

# No Slurm on these servers: no HPC tab, and nothing reduced for it. 1 turns it on (the
# installer's SLURM=yes, which also calls the hosts "login nodes").
RC_DASH_SLURM=0

# Accounts whose records the dashboard drops, comma-separated (and counts what it drops):
# every record of theirs, or their agents' only. The dashboard's own account, and the
# account deploy/fleet's pull logs in to the nodes as: their processes are the deployment,
# not anyone's work.
RC_DASH_DROP_USERS=@USER@,@PULL_USER@
RC_DASH_DROP_AGENT_USERS=

# 1: every user name the service sends out is an alias (dashboard/README.md, "Anonymized
# names"). The page asks for the password either way.
RC_DASH_ANONYMIZE=0

# What counts as risky differs by site: a profile, as a path under dashboard/
# (dashboard/risk-profiles/README.md). Empty: the built-in rules.
RC_DASH_RISK_PROFILE=
