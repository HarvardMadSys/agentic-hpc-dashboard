# @ETC@/fleet.env: the nodes deploy/fleet/pull.py copies, and how. KEY=VALUE, one per
# line, a value with spaces in quotes; KEY+=VALUE adds to a list. install-dashboard.sh
# writes this file only when there is none, and starts rc-pull once it names your nodes.
# After an edit, `systemctl reload rc-pull` (rc-deploy add-node / remove-node do it):
# nodes added start, nodes taken out stop, and the dashboard needs no restart.
# Every key pull.py takes is below; a FLEET_ key it does not know is an error.

# The nodes, separated by spaces: empty until you name them, and rc-pull waits until
# then. A name is the node's folder in the copy and in the dashboard; ssh reaches it by
# that name, completed with FLEET_DOMAIN, or by the target after `=`: node03=10.0.0.13,
# or a Host alias in the service account's ssh config. A node whose folders differ from
# FLEET_EBPF_SOURCE and FLEET_NODE_SOURCE below (an rrsync key on some nodes and not on
# others, or the RPM's /scratch/ebpfm) names its own after a colon:
# node03=10.0.0.13:ebpfm:ebpfm-login, or node04:/scratch/ebpfm: (no node tier).
# install-node.sh prints each node's line, ready to add here:
#   FLEET_HOSTS+=" node03=node03.example.org:ebpfm:ebpfm-login"
FLEET_HOSTS=
# The account pull.py logs in to each node as (install-node.sh makes it), and the domain.
FLEET_USER=@PULL_USER@
FLEET_DOMAIN=
# The key it logs in with (install-dashboard.sh makes it), and any other ssh options.
FLEET_SSH_KEY=@ETC@/pull_key
FLEET_SSH_OPTS=

# The collector's folders on each node. With a key restricted to `rrsync -ro /var/log`
# (deploy/fleet/README.md, "The nodes"), name them as rrsync sees them: ebpfm and
# ebpfm-login. FLEET_NODE_SOURCE empty: the node tier is not pulled. A node that has no
# node-tier folder is not an error; one with no eBPF-tier folder is.
FLEET_EBPF_SOURCE=/var/log/ebpfm
FLEET_NODE_SOURCE=/var/log/ebpfm-login

# The copy: <mirror>/ebpf/<node>/<day>/ and <mirror>/node/<node>/<day>/, private to the
# service account, which rc-dashboard reads it as.
FLEET_MIRROR=@STATE@/mirror
# The newest day folders copied (0: every one the node holds); the dashboard reads 8.
FLEET_DAYS=8
# Day folders the copy keeps per node, the oldest removed past it. 0 keeps every one: the
# copy may be the only one left of a day a node has since removed. Otherwise it must be at
# least FLEET_DAYS (and FLEET_DAYS not 0), or each pass would copy again what it removes.
FLEET_KEEP_DAYS=0

# Each node is copied every FLEET_INTERVAL_S seconds, by itself: a slow node delays no
# other. FLEET_TIMEOUT_S: rsync gives up on a node silent this long.
FLEET_INTERVAL_S=60
FLEET_TIMEOUT_S=600
# Nothing is copied while the copy's volume has less free space than this (FREE_MIN_GB,
# the name every kit gives it, works too).
FLEET_FREE_MIN_GB=10
# Nodes copied at once by `pull.py once` (`loop` copies every node on its own).
FLEET_JOBS=8
