# Copy to site.env (git ignores it) and fill it in. deploy.sh, ship-sender.sh, check.sh,
# and render.py read it, and fleet/pull-gz.sh reads the same names.
# A value may use $NAME or ${NAME} for a key set above it, or for HOME (this machine's
# home, not a remote one). Values that land in paths, units, or remote commands take no
# quotes, spaces, or backslashes; render.py checks them before anything is shipped.

# ---- The source nodes: the machines the collector runs on
# The account that logs in to them, their names, and the domain that completes each name
# (a node is <node>.<SOURCE_DOMAIN>; empty: each name as it is, such as a Host alias in
# ~/.ssh/config).
SOURCE_USER=your-account
SOURCE_NODES="login01 login02"
SOURCE_DOMAIN=cluster.example.org
# The collector's output folder on each node: /scratch/ebpfm for the packaged collector.
SOURCE_ROOT=/scratch/ebpfm
# The one thing the deployment keeps on the nodes: the sender, which the stream key's
# forced command runs (README.md, "First deploy"). A full path on the nodes. Empty: you
# install the sender yourself, and deploy.sh leaves the nodes alone.
SENDER_DIR=/home/your-account/rc-fleet-sender
# yes: the nodes share one home, as a cluster's login nodes do, so deploy.sh installs the
# sender once, through the first node that answers. no: on every node.
SHARED_HOME=yes

# ---- The dashboard's host
# The ssh login deploy.sh and check.sh use, the host's name (the unit runs only on a host
# whose name starts with it, for a home that other hosts share), and the one private
# folder there that holds everything: code, settings, the stream key, the copy of the
# nodes' data, the cache, and the logs. The page listens on 127.0.0.1:DASH_PORT there.
# DASH_PYTHON (3.11 or later) makes the dashboard's venv; the stream runs on
# /usr/bin/python3. 3.14 reduces about 10% faster than 3.12 and its panels are the same:
# `uv python install 3.14`, then DASH_PYTHON=$(uv python find 3.14). A deploy whose
# DASH_PYTHON is another version than the venv's makes the venv again (venv.old is the
# one before), and restarts the session.
DASH_SSH=your-account@dash.example.org
DASH_NODE=dash
DASH_ROOT=/data/your-account/rc-dashboard
DASH_PORT=8080
DASH_PYTHON=python3
# true: every folder in DASH_ROOT stays this account's own, mode 700. The stream stops
# itself, and the hourly check reports, when one is not, and each deploy resets the
# modes. false, on a host that only your team can log in to: the modes and ACLs stay as
# you set them, nothing checks them, and new folders and files in the copy follow its
# default ACL. A folder put in the copy's place still stops the stream.
PRIVATE_TREE=true

# ---- The page
# The name every page shows, and what the deployment watches in a few words (the Ask
# agent is told it). Both may have spaces.
SITE_NAME="Login nodes · live"
SITE_DESCRIPTION="a cluster's login nodes"
# A risk profile, as a path under dashboard/ (dashboard/risk-profiles/README.md), or
# empty for the built-in rules.
RISK_PROFILE=
# true: every user name in what the service sends out has an alias (dashboard/README.md,
# "Anonymize"). The page asks for a password either way.
ANONYMIZE=false
# The Codex CLI on the dashboard's host, as a full path, for Ask. Empty: Ask is off.
CODEX=

# ---- History and memory (README.md, "Memory")
# 7 days of history (windows 1h to 7d), up to 5 built views, the 1h, 6h, and 12h views
# built ahead, up to 150,000 sessions per view, the day cache on, and a 32G cap on the
# dashboard. The stream pauses when the copy's volume has less free space than
# FREE_MIN_GB, or than 10% of the volume if that is more.
HISTORY_DAYS=7
MAX_WINDOWS=5
PREWARM_MIN="60 360 720"
MAX_SESSIONS=150000
DAY_CACHE=true
# Processes reducing the hours, one node's share of an hour and one reducer group each
# (the dashboard's ingest.workers and ingest.reducer_groups). Empty: two per node in
# SOURCE_NODES, the most that helps; 1 reduces them in one pass in the dashboard's own
# process. They share DASH_MEMORY_MAX: ~0.5 GB each.
INGEST_WORKERS=
DASH_MEMORY_MAX=32G
FREE_MIN_GB=300

# ---- This machine: the one that runs deploy.sh and the hourly check
# The key it logs in to the nodes and to the dashboard's host with; where builds, logs,
# and the installed hourly check live; the web/node_modules for the bundle build (empty:
# deploy.sh runs npm ci in dashboard/web); and a file that holds a Slack webhook URL for
# the check's findings (mode 600, never printed; empty: findings go to the check's log
# only).
SSH_KEY=$HOME/.ssh/id_ed25519
WORK_DIR=$HOME/rc-dashboard-deploy
NODE_MODULES=
SLACK_WEBHOOK_FILE=
