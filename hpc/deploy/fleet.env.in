# Rendered by render.py from site.env: the copy's settings (deploy/fleet/pull.py), which
# keep-running.sh's copy window runs on this host. Each node's eBPF tier, into
# @DASH_ROOT@/data/mirror/<node>/<day>/, through the key whose forced command on the nodes
# is the guard (hpc/fleet/rsync_guard.py, installed in SENDER_DIR), over ssh's compression:
# the live day's JSON shrinks about as much as its .gz. pull.py reads this file again on
# SIGHUP, which a deploy sends it (install-remote.sh), so a node added to SOURCE_NODES
# needs no restart.
FLEET_HOSTS="@SOURCE_NODES@"
FLEET_USER=@SOURCE_USER@
FLEET_DOMAIN=@SOURCE_DOMAIN@
FLEET_SSH_KEY=@DASH_ROOT@/etc/rc_fleet_stream
FLEET_SSH_OPTS="-o Compression=yes"
FLEET_EBPF_SOURCE=@SOURCE_ROOT@
FLEET_NODE_SOURCE=
FLEET_LAYOUT=flat
FLEET_MIRROR=@DASH_ROOT@/data/mirror
FLEET_DAYS=@DAYS@
FLEET_FREE_MIN_GB=@FREE_MIN_GB_PLAIN@
FLEET_INTERVAL_S=60
