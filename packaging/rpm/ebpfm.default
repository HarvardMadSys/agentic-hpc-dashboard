# /etc/default/ebpfm — environment for the ebpfm.service (eBPF collector tier).
#
# Read by the systemd unit via `EnvironmentFile=-/etc/default/ebpfm`. Format is
# KEY=VALUE, one per line (systemd env-file syntax, NOT a shell script: no
# export, no command substitution, no $VAR expansion).
#
# Everything in the "tunables" sections below has a safe shipped default — those
# lines are commented out so this file changes nothing until you uncomment a
# key. The one ACTIVE line is EBPFM_MIN_UID (see its warning). After editing,
# `systemctl daemon-reload` is NOT required (EnvironmentFile is read at start),
# but you must restart the service: `systemctl restart ebpfm`.
#
# NOTE: EBPFM_OUTPUT_DIR is owned by the unit (the package substitutes its path)
# and intentionally cannot be overridden here — setting it has no effect.

# --- attribution (load-bearing — do not change the value) ------------------
# EBPFM_MIN_UID=0 is deliberate: it defines what actor3="human" MEANS. Raising
# it (e.g. to 1000 to drop system daemons) changes the human population and
# makes a capture incomparable with every earlier one. Leave it 0 and filter
# downstream on `attribution` instead. Shipped active so the value is explicit.
EBPFM_MIN_UID=0

# --- output permissions ----------------------------------------------------
# The collected JSONL is sensitive (argv, cwd, all-user I/O), so output dirs and
# files are created with NO access for "other" by default: dirs 0750, files
# 0640. To grant read access to a specific team, set EBPFM_GROUP to a group name
# or gid and the collector chgrps every dir/file it creates. Leave EBPFM_GROUP
# empty to keep the default (root) group. Modes are octal; empty/0 means "leave
# whatever the umask produced" (opt out of tightening).
#EBPFM_DIR_MODE=0750
#EBPFM_FILE_MODE=0640
#EBPFM_GROUP=

# --- output / cadence ------------------------------------------------------
# Where additional (node-tier) output lands. The eBPF tier's own output dir is
# fixed by the unit (defaults to /scratch/ebpfm — large, root-writable, unlike
# the small root disk); this is only consulted if you also run the node tier.
#EBPFM_NODE_OUTPUT_DIR=/scratch/ebpfm-login

# Compress sealed day-files to <file>.jsonl.gz (default on). Each day's streams
# are gzipped out of band when the day rolls over -- the live day stays plain --
# and a startup sweep catches any sealed day a prior run left uncompressed. The
# exits stream can exceed 1 GB/day; gzip is ~10-20x. Set to 0 to disable.
#EBPFM_COMPRESS=1

# Run for a fixed number of seconds then exit (0 = run forever, the default).
#EBPFM_DURATION=0

# Residency-sampling tick, seconds (0 disables the "what is alive now" view).
#EBPFM_RESIDENCY_S=60

# perf ring-buffer poll interval (ms) and pages per CPU. Larger pages absorb
# bigger exit bursts at the cost of locked memory.
#EBPFM_POLL_MS=100
#EBPFM_PERF_PAGES=256

# --- capture scope ---------------------------------------------------------
# Emitted argv cap in bytes (0 = uncapped; classification is always uncapped).
#EBPFM_ARGS_MAXLEN=0
# In-kernel argv read limit (bytes) — the real cap when ARGS_MAXLEN is 0.
#EBPFM_ARGV_KMAX=4096
# Per-write() payload capture (bytes).
#EBPFM_WRITE_KMAX=1024

# Drop processes shorter than this many seconds / below this CPU-second floor.
#EBPFM_MIN_DURATION=0.0
#EBPFM_MIN_CPU=0.0

# Garbage-collect tracking state for a pid this many seconds after exit.
#EBPFM_GC_GRACE=300

# --- network ---------------------------------------------------------------
# Fold connections for untracked pids too (1), and emit loopback/private peers
# (1). Both default off to keep records to agent-relevant egress.
#EBPFM_TCP_ALL=0
#EBPFM_CONN_ALL=0
# Peers/providers kept per record, and endpoints listed per record.
#EBPFM_CONNS_TOPN=5
#EBPFM_NET_ENDPOINTS_MAX=256
# Hold an exit record this many ms so late socket-close events fold into it.
#EBPFM_EXIT_HOLD_MS=250

# --- feature probing -------------------------------------------------------
# 'auto' probes the kernel for usable BPF blocks; a comma list pins them.
#EBPFM_FEATURES=auto
# Cache the probed feature set per kernel (1) to avoid re-probing on restart.
#EBPFM_FEATURE_CACHE=1
# Print per-block probe results to the journal on start (1).
#EBPFM_PROBE_VERBOSE=0
